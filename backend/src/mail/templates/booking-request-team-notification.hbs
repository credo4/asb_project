<!doctype html>
<html>
  <body style="font-family: Arial, sans-serif; color: #1a1a1a;">
    <p>Nouvelle demande de réservation reçue via le site public.</p>
    <table cellpadding="6" cellspacing="0" style="border-collapse: collapse;">
      <tr><td><strong>Référence</strong></td><td>{{reference}}</td></tr>
      <tr><td><strong>Service</strong></td><td>{{serviceType}}</td></tr>
      <tr><td><strong>Contact</strong></td><td>{{fullName}} — {{organization}}</td></tr>
      <tr><td><strong>Email</strong></td><td>{{workEmail}}</td></tr>
      <tr><td><strong>Résumé</strong></td><td>{{summary}}</td></tr>
    </table>
    <p>
      <a
        href="{{backOfficeUrl}}"
        style="display:inline-block;padding:10px 20px;background:#111;color:#fff;text-decoration:none;border-radius:4px;"
        >Voir le dossier dans le back-office</a
      >
    </p>
    <p>— Africa Speakers Bureau</p>
  </body>
</html>
