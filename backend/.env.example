# =============================================================================
# Africa Speakers Bureau — Backend
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne JAMAIS committer le fichier .env (voir .gitignore).
# =============================================================================

# --- Application ---
# En production (VPS) : NODE_ENV=production, APP_URL/FRONTEND_URL/
# PUBLIC_SITE_ORIGINS avec les vrais domaines (jamais localhost), et
# TRUST_PROXY=true SI (et seulement si) l'app tourne derrière un reverse
# proxy de confiance (nginx sur le même VPS) — sinon laisser à false/absent,
# un client pourrait sinon usurper son IP et contourner le rate-limit.
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Origines du SITE PUBLIC autorisées en CORS pour /public/*, séparées par des
# virgules (plusieurs environnements possibles : staging, prod...). Jamais de
# wildcard "*". Exemple : "https://africaspeakersbureau.com,https://staging.africaspeakersbureau.com"
PUBLIC_SITE_ORIGINS=http://localhost:4321

# --- Base de données (MySQL 8) ---
DATABASE_URL="mysql://user:password@localhost:3306/asb_db"

# --- Stockage fichiers (médias) ---
# Chemin relatif à backend/ (ou absolu). Contient deux sous-dossiers :
# public/ (servi en lecture seule sous /uploads) et private/ (jamais exposé).
STORAGE_ROOT=./storage

# --- Auth JWT ---
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Emails (nodemailer / @nestjs-modules/mailer) ---
# En dev, pointer vers un transport de test (Ethereal https://ethereal.email
# ou Mailtrap https://mailtrap.io) : créer une inbox de test et copier ses
# identifiants ici. Ne jamais utiliser un vrai compte SMTP en dev.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=changeme
MAIL_PASSWORD=changeme
MAIL_FROM="Africa Speakers Bureau <no-reply@africaspeakersbureau.com>"

# --- Traçage analytics (Phase 3, §3a) ---
# Sel secret combiné à la date du jour pour dériver `visitorHash` (voir
# AnalyticsService) : change chaque jour, aucune IP n'est jamais stockée en
# clair. À générer aléatoirement en production (jamais réutiliser la valeur
# d'exemple ci-dessous).
ANALYTICS_SALT=changeme-analytics-salt

# --- Conversion candidature -> compte speaker (Phase 3c, §4.4) ---
# Durée de vie du lien d'invitation envoyé au candidat converti, en jours.
INVITATION_TOKEN_TTL_DAYS=14

# --- Seed : compte SUPER_ADMIN de bootstrap (Phase 0) ---
# Sans ces variables, le seed n'insère aucun compte (aucune inscription
# publique n'existe encore : les comptes sont provisionnés par un admin).
SEED_ADMIN_EMAIL=admin@africaspeakersbureau.com
SEED_ADMIN_PASSWORD=changeme-admin-password
