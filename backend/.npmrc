# Certaines plateformes de déploiement (dont l'hébergement Node.js
# d'Hostinger) exécutent `npm install` avec NODE_ENV=production déjà actif
# — le comportement historique de npm est alors de sauter les
# devDependencies. `production=false` force l'installation complète quoi
# qu'il arrive. Filet de sécurité : les paquets réellement indispensables
# au build/runtime (@nestjs/cli, typescript, prisma, ts-node, @types/*
# utilisés par src/) sont de toute façon classés en "dependencies", pas en
# "devDependencies" — donc le build réussit même si ce fichier est ignoré.
production=false
