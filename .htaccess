# Back-office Vue 3 en mode "history" (vue-router `createWebHistory()`,
# voir router/index.ts) : chaque route (/reports, /settings, /speakers/42…)
# est un vrai chemin d'URL côté navigateur, mais un seul fichier existe
# réellement sur le serveur (index.html) — le routage se fait en JS après
# coup. Sans cette règle, Apache renverrait une 404 brute sur tout
# rafraîchissement de page qui n'est pas la racine.
#
# Nécessaire ici car l'hébergement Hostinger de ce site sert les fichiers
# statiques directement (déploiement Git "publication brute", sans étape de
# build ni pipeline SPA dédiée) — voir CLAUDE.md §2b pour le contexte du
# déploiement manuel (dist/ compilé en local, poussé dans le dépôt credo4).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ne pas réécrire les fichiers/dossiers qui existent réellement
  # (assets compilés, favicon…).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
